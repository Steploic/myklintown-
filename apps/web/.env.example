# Supabase — Settings > API dans le dashboard supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role — UNIQUEMENT côté serveur, jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Provider Mobile Money (CinetPay, Campay, etc.) — à configurer plus tard
MOMO_PROVIDER=campay
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=

# URL canonique (utile pour les redirects auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
