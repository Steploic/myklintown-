# Supabase — Settings > API dans le dashboard supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Clé secrète (« secret key » sb_secret_…, Settings > API Keys) — UNIQUEMENT côté
# serveur, jamais exposée au navigateur. Sert au paiement en ligne (transactions
# écrites par le serveur seul). L'ancienne SUPABASE_SERVICE_ROLE_KEY reste acceptée.
# Sur Vercel : variable marquée « Sensitive ». À ne poser que si le paiement en ligne est ouvert.
SUPABASE_SECRET_KEY=

# Paiement en ligne Mobile Money — Notch Pay (compte Business, comptes connectés).
# Sans NOTCHPAY_PUBLIC_KEY, le paiement en ligne reste masqué dans l'application.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
# Clé de signature des notifications (webhook) : Notch Pay > Settings > Webhooks.
NOTCHPAY_WEBHOOK_HASH=

# Mode simulation (aucun argent réel) : POSTE LOCAL et BASE DE TEST uniquement.
# Ignoré sur Vercel et refusé si l'application vise la base de production.
# PAIEMENT_SIMULATION=1

# URL canonique (utile pour les redirects auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
